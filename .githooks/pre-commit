#!/usr/bin/env bash
# Format check and lint on staged Swift files. Installed with `make hooks`.
set -euo pipefail

files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')

((${#files[@]} == 0)) && exit 0
make --no-print-directory lint-files FILES="${files[*]}"
